{
  "name": "@prjct.app/pi-proto",
  "version": "0.2.0",
  "description": "Prototype for Pi: a framework-neutral design guide and versioned HTML prototypes served by a local daemon.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-proto.git"
  },
  "bugs": {
    "url": "https://github.com/prjct-app/pi-proto/issues"
  },
  "homepage": "https://github.com/prjct-app/pi-proto#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "prototyping",
    "design",
    "html",
    "tailwind",
    "gsap"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-proto/main/docs/cover.png"
  },
  "files": [
    "index.ts",
    "src",
    "viewer/src",
    "viewer/dist",
    "viewer/build.mjs",
    "viewer/package.json",
    "viewer/package-lock.json",
    "viewer/tsconfig.json",
    "viewer/index.html",
    "scripts/build-pi.mjs",
    "scripts/check-immutable.ts",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/cover.png"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:immutable && npm --prefix viewer run check",
    "test": "node --import ./tests/isolate.mjs --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "npm run build:viewer && node --import ./tests/isolate.mjs --import tsx --test tests/viewer.browser.ts",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "check:immutable": "node --import tsx scripts/check-immutable.ts",
    "build:viewer": "npm --prefix viewer run build",
    "build:pi": "npm run build:viewer && node scripts/build-pi.mjs",
    "daemon": "node --import tsx src/daemon/cli.ts",
    "prepack": "npm --prefix viewer ci --ignore-scripts --no-audit --no-fund && npm run build:viewer"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "gsap": "^3.12.5",
    "linkedom": "^0.18.0",
    "marked": "^14.1.4",
    "picomatch": "^4.0.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.1",
    "playwright-core": "^1.50.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "shell-quote": "1.12.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  },
  "piBuild": {
    "copy": [
      "src/runtime-browser/runtime.js",
      "viewer/dist"
    ],
    "external": [
      "playwright",
      "playwright-core",
      "tailwindcss",
      "@tailwindcss/postcss",
      "@tailwindcss/oxide",
      "@tailwindcss/oxide-darwin-arm64",
      "postcss",
      "gsap"
    ],
    "entries": [
      "index.ts",
      "src/daemon/cli.ts"
    ],
    "standalone": [
      "src/daemon/cli.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
